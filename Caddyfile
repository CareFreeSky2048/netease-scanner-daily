{$SCANNER_DOMAIN} {
    basic_auth {
        {$WEB_USER} {$WEB_PASSWORD_HASH}
    }
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
    reverse_proxy scanner:5000 {
        flush_interval -1
    }
}
