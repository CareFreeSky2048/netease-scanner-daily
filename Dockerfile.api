FROM node:22.14.0-bookworm-slim
WORKDIR /app
COPY api-package.json package.json
COPY api-package-lock.json package-lock.json
RUN npm ci --omit=dev
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 TZ=Asia/Shanghai
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "node_modules/NeteaseCloudMusicApi/app.js"]
